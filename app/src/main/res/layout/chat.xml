<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header with Back Button, Title, and Status Info -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back_arrow"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chats"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Status Icons and Info (Time, Network, Battery) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Time Display -->
            <TextView
                android:id="@+id/timeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:22 PM"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ScrollView for Chat Messages -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Chat List Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Chat Item -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background2"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:elevation="2dp">

                <!-- Chat Icon -->
                <ImageView
                    android:id="@+id/chatIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/chatting"
                    android:contentDescription="Chat Icon"
                    android:layout_marginEnd="8dp"/>

                <!-- Chat Text and Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/chatName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO BIKER"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/chatMessagePreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.12 ALERT! 🚨 Many people just ordered..."
                        android:textSize="14sp"
                        android:textColor="#808080"/>
                </LinearLayout>

                <!-- Chat Date -->
                <TextView
                    android:id="@+id/chatDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/12/2023"
                    android:textSize="12sp"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
